APP_ENV=development
POSTGRES_PASSWORD=change_owner
NEXKOSMO_APP_PASSWORD=change_me
NEXKOSMO_AUDIT_PASSWORD=change_audit
DATABASE_URL=postgresql+asyncpg://nexkosmo_app:change_me@postgres:5432/nexkosmo
MIGRATION_DATABASE_URL=postgresql+psycopg://nexkosmo_owner:change_owner@postgres:5432/nexkosmo
AUDIT_DATABASE_URL=postgresql+asyncpg://nexkosmo_audit:change_audit@postgres:5432/nexkosmo
OIDC_ISSUER=https://identity.example.invalid/
OIDC_AUDIENCE=nexkosmo-semantic-kernel
OIDC_JWKS_URL=https://identity.example.invalid/.well-known/jwks.json
LOG_LEVEL=INFO
AUTH_MODE=development
DEVELOPMENT_WORKSPACE_ID=00000000-0000-4000-8000-000000000001
DEVELOPMENT_PRINCIPAL_ID=00000000-0000-4000-8000-000000000002
DEVELOPMENT_AGENT_ID=00000000-0000-4000-8000-000000000003
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
MIGRATION_HEAD=0011_environment_forest
OUTBOX_DISPATCHER_ENABLED=false
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
