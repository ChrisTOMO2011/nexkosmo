{"schema":"Nexkosmo.VersioningRules","schema_version":"1.0.0","version_scheme":"semantic","format":"MAJOR.MINOR.PATCH","increments":{"major":"breaking canonical changes","minor":"backwards-compatible additions","patch":"fixes and metadata updates"},"lifecycle":["draft","review","approved","released","deprecated","archived"],"rules":{"released_versions_immutable":true,"new_release_requires_new_version":true,"every_version_requires_changelog":true,"every_version_requires_checksum":true,"rollback_requires_previous_release":true,"canonical_id_never_changes":true,"asset_uuid_never_changes":true,"draft_versions_may_change":true}}