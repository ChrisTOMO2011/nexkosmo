{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Nexkosmo.AssetRecord",
  "title": "Nexkosmo Canonical Asset Record",
  "type": "object",
  "required": ["asset_id", "asset_uuid", "name", "asset_type", "department", "status", "version", "owner", "relationships", "dependencies", "provenance", "confidence"],
  "properties": {
    "asset_id": {"type": "string", "pattern": "^NK\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)+$"},
    "asset_uuid": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "asset_type": {"type": "string", "enum": ["character", "creature", "environment", "prop", "vehicle", "weapon", "clothing", "model", "sculpt", "mesh", "texture", "material", "groom", "rig", "skeleton", "blendshape", "animation", "simulation", "audio", "vfx", "camera", "lighting", "render", "document", "package", "other"]},
    "department": {"type": "string", "minLength": 1},
    "project_id": {"type": "string"},
    "sequence_id": {"type": "string"},
    "scene_id": {"type": "string"},
    "shot_id": {"type": "string"},
    "status": {"$ref": "status-vocabulary.json#/$defs/status"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "owner": {"type": "object", "required": ["team"], "properties": {"team": {"type": "string"}, "user_id": {"type": "string"}}, "additionalProperties": false},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "software": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "plugin_versions": {"type": "object", "additionalProperties": {"type": "string"}}}, "additionalProperties": false}},
    "formats": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "relationships": {"type": "array", "items": {"$ref": "relationship-vocabulary.json#/$defs/relationship"}},
    "dependencies": {"type": "array", "items": {"$ref": "dependency-vocabulary.json#/$defs/dependency"}},
    "provenance": {"$ref": "provenance-schema.json"},
    "confidence": {"$ref": "confidence-schema.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}