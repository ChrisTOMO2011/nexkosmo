{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Nexkosmo.CanonicalAssetManifest",
  "title": "Nexkosmo Canonical Asset Manifest",
  "type": "object",
  "required": ["manifest_schema", "schema_version", "manifest_id", "manifest_uuid", "asset", "namespace", "version", "status", "assets", "files", "approvals"],
  "properties": {
    "manifest_schema": {"const": "Nexkosmo.CanonicalAssetManifest"},
    "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "manifest_id": {"type": "string", "pattern": "^NK\\.MANIFEST\\.[A-Z0-9_.]+$"},
    "manifest_uuid": {"type": "string", "format": "uuid"},
    "asset": {"$ref": "asset-record.schema.json"},
    "namespace": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"$ref": "status-vocabulary.json#/$defs/status"},
    "canonical_id_policy": {"$ref": "canonical-id-policy.json"},
    "assets": {"type": "array", "items": {"$ref": "asset-record.schema.json"}, "uniqueItems": true},
    "files": {"type": "array", "items": {"$ref": "file-metadata.schema.json"}},
    "approvals": {"type": "array", "items": {"$ref": "approval.schema.json"}},
    "release_gates": {"$ref": "release-gates.json"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}